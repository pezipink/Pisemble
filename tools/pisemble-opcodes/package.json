{
  "name": "pisemble-opcodes",
  "displayName": "Pisemble Opcodes",
  "description": "Colours AArch64 mnemonics inside Pisemble { } blocks in Magic Racket files",
  "version": "0.1.0",
  "publisher": "pisemble",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.racket.pisemble-opcodes",
        "path": "./syntaxes/pisemble-opcodes.tmLanguage.json",
        "injectTo": [
          "source.racket"
        ]
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "keyword.other.opcode.pisemble",
            "settings": {
              "foreground": "#C586C0",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "entity.name.label.definition.pisemble",
              "entity.name.label.reference.pisemble"
            ],
            "settings": {
              "foreground": "#4EC9B0",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "keyword.operator.alignment.pisemble",
            "settings": {
              "foreground": "#D7BA7D",
              "fontStyle": "bold"
            }
          }
        ]
      }
    }
  }
}
