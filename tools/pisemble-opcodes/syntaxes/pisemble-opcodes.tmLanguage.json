{
  "name": "Pisemble opcodes",
  "scopeName": "source.racket.pisemble-opcodes",
  "injectionSelector": "L:source.racket -comment -string",
  "patterns": [
    {
      "include": "#string-double"
    },
    {
      "include": "#comment-line"
    },
    {
      "include": "#arm-block"
    },
    {
      "include": "#label-definition"
    },
    {
      "include": "#label-reference"
    },
    {
      "include": "#alignment"
    }
  ],
  "repository": {
    "arm-block": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#arm-block"
        },
        {
          "include": "#opcode"
        },
        {
          "include": "#label-reference"
        },
        {
          "include": "source.racket"
        }
      ]
    },
    "opcode": {
      "match": "(?<=^|[\\s{(\\[])(?:b\\.(?:eq|ne|cs|cc|mi|pl|vs|vc|hi|ls|ge|lt|gt|le|al)|adc|add|adds|adr|and|ands|asr|b|bfi|bic|bics|bl|blr|br|brk|cbz|cbnz|ccmp|cinc|clz|cmn|cmp|cneg|csel|csinc|csinv|csneg|cset|dmb|dsb|dup|eor|eret|extr|hlt|hvc|isb|ld1|ldar|ldaxr|ldp|ldr|ldrh|ldrb|ldrsb|ldrsh|ldrsw|ldur|ldurb|ldurh|ldursb|ldursh|ldursw|ldxr|lsl|lsr|madd|mneg|mov|movi|movk|movn|movz|mrs|msr|msub|mul|mvn|neg|nop|orn|orr|prfm|rbit|rev16|rev32|ret|ror|sbc|sbfm|sbfx|scvtf|sdiv|sev|smc|smull|smulh|st1|stlr|stlxr|stp|str|strb|strh|stur|stxr|sub|subs|svc|sxtb|sxth|sxtw|tbnz|tbz|tst|ubfm|ubfx|udiv|umull|umulh|uxtb|uxth|wfe|wfi|fabs|fadd|fcmp|fcsel|fcvtzs|fcvtzu|fdiv|fmadd|fmax|fmin|fmov|fmsub|fmul|fneg|fnmadd|fnmsub|fsqrt|fsub|ucvtf)(?=$|[\\s})\\]])",      "name": "keyword.other.opcode.pisemble"
    },
    "label-definition": {
      "match": "(?<=^|[\\s(\\[{]):[A-Za-z_][\\w!?.\\-]*(?=$|[\\s()\\[\\]{}])",
      "name": "entity.name.label.definition.pisemble"
    },
    "label-reference": {
      "match": "(?<=^|[\\s(\\[{])[A-Za-z_][\\w!?.\\-]*(?:[:+]|-)(?=$|[\\s()\\[\\]{}])",
      "name": "entity.name.label.reference.pisemble"
    },
    "alignment": {
      "match": "(?<=^|[\\s(\\[{])/=(?=$|[\\s()\\[\\]{}])",
      "name": "keyword.operator.alignment.pisemble"
    },
    "string-double": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.racket",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.racket"
        }
      ]
    },
    "comment-line": {
      "begin": ";",
      "end": "$",
      "name": "comment.line.semicolon.racket"
    }
  }
}
